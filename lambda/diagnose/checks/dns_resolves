#!/bin/bash
# Check: DNS record resolves (if domain configured)

if [ -z "${SCOPE_DOMAIN:-}" ] || [ "$SCOPE_DOMAIN" = "null" ]; then
   echo "   No domain configured, skipping DNS check"

   update_check_result --status "skipped" --evidence "$(evidence_json \
      "No domain configured, check skipped" \
      "info" \
      "[]" \
      "{}" \
      "[]")"
   return 0
fi

echo "   Checking domain: $SCOPE_DOMAIN"

dns_result=$(dig +short "$SCOPE_DOMAIN" 2>/dev/null | grep -v '^;;') || dns_result=""

if [ -z "$dns_result" ]; then
   echo "❌ Domain '$SCOPE_DOMAIN' does not resolve" >&2
   echo "💡 Possible causes:" >&2
   echo "   - DNS record has not been created yet" >&2
   echo "   - DNS propagation is still in progress" >&2
   echo "   - The domain name is incorrect" >&2
   echo "🔧 How to fix:" >&2
   echo "   - Wait a few minutes for DNS propagation" >&2
   echo "   - Verify the Route53 record exists for '$SCOPE_DOMAIN'" >&2
   echo "   - Check that the hosted zone is correctly configured" >&2

   update_check_result --status "failed" --evidence "$(evidence_json \
      "Domain '$SCOPE_DOMAIN' does not resolve" \
      "critical" \
      "$(jq -nc --arg d "$SCOPE_DOMAIN" '[$d]')" \
      "$(jq -nc --arg d "$SCOPE_DOMAIN" '{domain: $d}')" \
      "$(jq -nc --arg d "$SCOPE_DOMAIN" '["Wait a few minutes for DNS propagation", "Verify the Route53 record exists for \($d)", "Check that the hosted zone is correctly configured"]')")"
   return 1
fi

echo "   Domain resolves to: $dns_result"

update_check_result --status "success" --evidence "$(evidence_json \
   "Domain '$SCOPE_DOMAIN' resolves" \
   "info" \
   "[]" \
   "$(jq -nc --arg d "$SCOPE_DOMAIN" --arg r "$dns_result" '{domain: $d, records: ($r | split("\n") | map(select(length > 0)))}')" \
   "[]")"
