#!/bin/bash
# Check: Networking (API Gateway or ALB) is healthy

require_function_name || return 1

# Event-driven scopes (http_enabled=false) have no HTTP integration to verify.
if echo "$CONTEXT" | jq -e '.scope.capabilities.http_enabled == false' > /dev/null 2>&1; then
   echo "   HTTP disabled for this scope, skipping networking check"

   update_check_result --status "skipped" --evidence "$(evidence_json \
      "HTTP disabled for this scope, check skipped" \
      "info" \
      "[]" \
      "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" '{function_name: $f, http_enabled: false}')" \
      "[]")"
   return 0
fi

visibility=$(echo "$CONTEXT" | jq -r '.scope.capabilities.visibility // "public"')

# The resource-based policy holds the permissions granted to API Gateway or ALB.
permissions=$(aws lambda get-policy \
   --function-name "$LAMBDA_FUNCTION_NAME" \
   2>&1 || echo "{}")

if [ "$visibility" = "public" ]; then
   integration="API Gateway"
   principal="apigateway"
   causes=("The Lambda resource-based policy is missing the API Gateway permission" "The API Gateway integration has not been created")
   actions=("Re-run Terraform to configure API Gateway permissions" "Verify the API Gateway integration references this function")
else
   integration="ALB"
   principal="elasticloadbalancing"
   causes=("The Lambda resource-based policy is missing the ALB permission" "The ALB target group has not been registered")
   actions=("Re-run Terraform to configure ALB permissions" "Verify the ALB target group references this function")
fi

echo "   Checking $integration integration (visibility: $visibility)..."

details=$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" --arg v "$visibility" --arg i "$integration" \
   '{function_name: $f, visibility: $v, integration: $i}')

if echo "$permissions" | grep -q "$principal"; then
   echo "   $integration permission configured for $LAMBDA_FUNCTION_NAME"

   update_check_result --status "success" --evidence "$(evidence_json \
      "$integration permission configured for '$LAMBDA_FUNCTION_NAME'" \
      "info" \
      "[]" \
      "$details" \
      "[]")"
   return 0
fi

echo "❌ $integration permission may not be configured for '$LAMBDA_FUNCTION_NAME'" >&2
echo "💡 Possible causes:" >&2
printf '   - %s\n' "${causes[@]}" >&2
echo "🔧 How to fix:" >&2
printf '   - %s\n' "${actions[@]}" >&2

update_check_result --status "warning" --evidence "$(evidence_json \
   "$integration permission may not be configured for '$LAMBDA_FUNCTION_NAME'" \
   "warning" \
   "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" '[$f]')" \
   "$details" \
   "$(printf '%s\n' "${actions[@]}" | jq -R . | jq -sc .)")"
