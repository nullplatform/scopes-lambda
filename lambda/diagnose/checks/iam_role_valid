#!/bin/bash
# Check: IAM execution role is valid

require_function_name || return 0

# Get the role ARN from the function configuration
config=$(aws lambda get-function-configuration \
   --function-name "$LAMBDA_FUNCTION_NAME" \
   2>&1 || echo "{}")

role_arn=$(echo "$config" | jq -r '.Role // ""' 2>/dev/null || echo "")

if [ -z "$role_arn" ] || [ "$role_arn" = "null" ]; then
   echo "❌ No IAM role configured for Lambda function '$LAMBDA_FUNCTION_NAME'" >&2
   echo "💡 Possible causes:" >&2
   echo "   - Function configuration could not be retrieved" >&2
   echo "   - The function was created without an execution role" >&2
   echo "🔧 How to fix:" >&2
   echo "   - Verify the function exists and has a valid execution role" >&2
   echo "   - Check the Terraform configuration for the IAM role" >&2

   update_check_result --status "failed" --evidence "$(evidence_json \
      "No IAM role configured for Lambda function '$LAMBDA_FUNCTION_NAME'" \
      "critical" \
      "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" '[$f]')" \
      "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" '{function_name: $f}')" \
      '["Verify the function exists and has a valid execution role", "Check the Terraform configuration for the IAM role"]')"
   return 0
fi

# Extract role name from ARN
role_name=$(echo "$role_arn" | sed 's/.*role\///')
details=$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" --arg arn "$role_arn" --arg r "$role_name" \
   '{function_name: $f, role_arn: $arn, role_name: $r}')

# Check if role exists
role_check=$(aws iam get-role --role-name "$role_name" 2>&1 || echo "NOT_FOUND")

if echo "$role_check" | grep -q "NoSuchEntity\|NOT_FOUND"; then
   echo "❌ IAM role '$role_name' does not exist" >&2
   echo "💡 Possible causes:" >&2
   echo "   - The IAM role was deleted outside of Terraform" >&2
   echo "   - The role ARN references a different AWS account" >&2
   echo "🔧 How to fix:" >&2
   echo "   - Re-run Terraform to recreate the IAM role" >&2
   echo "   - Verify the correct AWS account is being used" >&2

   update_check_result --status "failed" --evidence "$(evidence_json \
      "IAM role '$role_name' does not exist" \
      "critical" \
      "$(jq -nc --arg r "$role_name" '[$r]')" \
      "$details" \
      '["Re-run Terraform to recreate the IAM role", "Verify the correct AWS account is being used"]')"
   return 0
fi

if ! echo "$role_check" | jq -e '[.Role.AssumeRolePolicyDocument.Statement[]? | select(.Effect == "Allow") | .Principal.Service // empty] | flatten | index("lambda.amazonaws.com")' > /dev/null 2>&1; then
   echo "❌ IAM role '$role_name' does not trust lambda.amazonaws.com" >&2
   echo "💡 Possible causes:" >&2
   echo "   - The role trust policy was modified outside of Terraform" >&2
   echo "🔧 How to fix:" >&2
   echo "   - Re-run Terraform to restore the role trust policy" >&2

   update_check_result --status "failed" --evidence "$(evidence_json \
      "IAM role '$role_name' does not trust lambda.amazonaws.com" \
      "critical" \
      "$(jq -nc --arg r "$role_name" '[$r]')" \
      "$details" \
      '["Re-run Terraform to restore the role trust policy"]')"
   return 0
fi

echo "   IAM role is valid: $role_name"

update_check_result --status "success" --evidence "$(evidence_json \
   "IAM role '$role_name' is valid" \
   "info" \
   "[]" \
   "$details" \
   "[]")"
