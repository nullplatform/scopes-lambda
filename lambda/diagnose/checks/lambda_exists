#!/bin/bash
# Check: Lambda function exists

require_function_name || return 0

result=$(aws lambda get-function \
   --function-name "$LAMBDA_FUNCTION_NAME" \
   2>&1 || echo "NOT_FOUND")

if echo "$result" | grep -q "ResourceNotFoundException\|NOT_FOUND"; then
   echo "❌ Lambda function '$LAMBDA_FUNCTION_NAME' does not exist" >&2
   echo "💡 Possible causes:" >&2
   echo "   - The function was deleted outside of Terraform" >&2
   echo "   - The scope provisioning did not complete successfully" >&2
   echo "   - The function name in the NRN is incorrect" >&2
   echo "🔧 How to fix:" >&2
   echo "   - Re-run the scope provisioning workflow" >&2
   echo "   - Verify the function name '$LAMBDA_FUNCTION_NAME' in the AWS console" >&2
   echo "   - Check Terraform state for drift" >&2

   update_check_result --status "failed" --evidence "$(evidence_json \
      "Lambda function '$LAMBDA_FUNCTION_NAME' does not exist" \
      "critical" \
      "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" '[$f]')" \
      "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" '{function_name: $f}')" \
      "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" '["Re-run the scope provisioning workflow", "Verify the function name \($f) in the AWS console", "Check Terraform state for drift"]')")"
   return 0
fi

echo "   Lambda function exists: $LAMBDA_FUNCTION_NAME"

update_check_result --status "success" --evidence "$(evidence_json \
   "Lambda function '$LAMBDA_FUNCTION_NAME' exists" \
   "info" \
   "[]" \
   "$(jq -nc --arg f "$LAMBDA_FUNCTION_NAME" --arg arn "${LAMBDA_FUNCTION_ARN:-}" '{function_name: $f, function_arn: $arn}')" \
   "[]")"
