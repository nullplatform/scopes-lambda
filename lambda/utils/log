#!/bin/bash

# Logging utility — log4j-style level filtering
# Usage:    log "level" "message"
# Levels:   debug < info < warn < error
# Control:  LOG_LEVEL env var (default: info)
#
# Example:
#   LOG_LEVEL=info
#   log debug "verbose details"  # suppressed
#   log info  "deployment done"  # shown
log() {
  local level="${1:-info}"
  local message="${2:-}"

  local -i msg_num threshold

  # Lowercase via tr rather than ${var,,}: the latter needs bash 4, and macOS
  # ships bash 3.2, which would break every script that sources this locally.
  level=$(printf '%s' "$level" | tr '[:upper:]' '[:lower:]')

  case "$level" in
    debug) msg_num=0 ;;
    info)  msg_num=1 ;;
    warn)  msg_num=2 ;;
    error) msg_num=3 ;;
    *)     msg_num=1 ;;
  esac

  case "$(printf '%s' "${LOG_LEVEL:-info}" | tr '[:upper:]' '[:lower:]')" in
    debug) threshold=0 ;;
    info)  threshold=1 ;;
    warn)  threshold=2 ;;
    error) threshold=3 ;;
    *)     threshold=1 ;;
  esac

  if [ "$msg_num" -ge "$threshold" ]; then
    echo "$message"
  fi
}
