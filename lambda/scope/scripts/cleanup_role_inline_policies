#!/bin/bash
# Drop the inline policies this scope writes outside terraform, before destroy.
#
# IAM refuses DeleteRole while unmanaged inline policies remain; sync_dead_letter_queue
# and merge_iam_policies both write some through the CLI. Terraform's own are left
# alone — a failed destroy leaves the function running, and stripping them would
# cost it logs, ECR and Secrets Manager access with nothing to restore them.
#
# On a shared role only this scope's policies can be identified; the rest are
# reported. Best-effort: a missing role or policy is the normal case.

source "$SERVICE_PATH/utils/get_config_value"
source "$SERVICE_PATH/utils/log"

log info "🔍 Cleaning up scope-managed inline role policies..."

if [ -z "${LAMBDA_FUNCTION_NAME:-}" ] || [ "$LAMBDA_FUNCTION_NAME" = "null" ]; then
  log debug "   ⏭️  LAMBDA_FUNCTION_NAME not set — nothing to clean up"
  return 0
fi

cleanup_role_prefix=$(get_config_value \
  --provider '.providers["scope-configurations"].lambda.execution_role_prefix' \
  --env LAMBDA_EXECUTION_ROLE_PREFIX \
  --default 'np-lambda-')

# The role terraform owns, named after this function alone.
scope_managed_role="${cleanup_role_prefix}${LAMBDA_FUNCTION_NAME}-role"
scope_managed_role="${scope_managed_role:0:64}"

# Prefer the role the function actually runs on; fall back to the derived name
# for the case where the function is already gone.
cleanup_role_name=$(aws lambda get-function-configuration \
  --function-name "$LAMBDA_FUNCTION_NAME" \
  --query 'Role' --output text 2>/dev/null || echo "")
cleanup_role_name="${cleanup_role_name##*/}"

if [ -z "$cleanup_role_name" ] || [ "$cleanup_role_name" = "None" ]; then
  cleanup_role_name="$scope_managed_role"
fi

log debug "   📋 execution_role=$cleanup_role_name"

inline_policies=$(aws iam list-role-policies \
  --role-name "$cleanup_role_name" \
  --query 'PolicyNames' --output text 2>/dev/null || echo "")

if [ -z "$inline_policies" ] || [ "$inline_policies" = "None" ]; then
  log debug "   ⏭️  No inline policies on $cleanup_role_name"
  echo ""
  log info "✨ Inline role policies cleaned up"
  return 0
fi

# A role named after this function is dedicated to it and is about to be
# destroyed, so every inline policy on it can go. A shared dedicated role
# outlives the scope, so only this scope's own policies may be touched.
# Names terraform owns on this role (iam/modules/main.tf), plus any custom ones
# it attaches from the scope configuration.
tf_managed="cloudwatch-logs
ecr-image-pull
secrets-manager-parameters-read
$(echo "${CONTEXT:-\{\}}" | jq -r '.providers["scope-configurations"].lambda.role_policies // [] | if type == "array" then (.[] | .name // empty) else empty end' 2>/dev/null)"

if [ "$cleanup_role_name" = "$scope_managed_role" ]; then
  log debug "   📋 role is scope-managed — removing every policy terraform does not own"
  policies_to_delete=$(printf '%s' "$inline_policies" | tr '\t' '\n' \
    | grep -vxF -f <(printf '%s\n' "$tf_managed") || echo "")
else
  log debug "   📋 role is shared — removing only this scope's policies"
  # Per-deployment policy names carry no scope marker, so on a shared role they
  # cannot be attributed. Report them: they count against the role's inline
  # policy quota and will need removing by hand.
  leftovers=$(printf '%s' "$inline_policies" | tr '\t' '\n' \
    | grep -vEx "np-lambda-dlq-[0-9]+" || echo "")
  if [ -n "$leftovers" ]; then
    log warn "   ⚠️  Left on shared role $cleanup_role_name (cannot attribute to a scope): $(echo "$leftovers" | tr '\n' ' ')"
  fi
  # --output text returns the names tab-separated
  policies_to_delete=$(printf '%s' "$inline_policies" | tr '\t' '\n' \
    | grep -Ex "np-lambda-dlq-${SCOPE_ID:-__unset__}" || echo "")
fi

for policy_name in $policies_to_delete; do
  if aws iam delete-role-policy \
    --role-name "$cleanup_role_name" \
    --policy-name "$policy_name" >/dev/null 2>&1; then
    log info "   📝 Removed inline policy $policy_name from $cleanup_role_name"
  else
    log warn "   ⚠️  Could not remove inline policy $policy_name from $cleanup_role_name"
  fi
done

echo ""
log info "✨ Inline role policies cleaned up"
