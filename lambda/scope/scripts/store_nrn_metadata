#!/bin/bash
# Publish the scope's Lambda identity (and the ALB rule priority) to its NRN,
# so other services can target the alias without re-deriving names.
#
# Values come from do_tofu's outputs; the update path has no tofu run, so gaps
# are resolved from AWS — which also backfills pre-existing scopes.

source "$SERVICE_PATH/utils/log"

log info "📝 Storing scope metadata in NRN..."

if [ -z "${SCOPE_NRN:-}" ]; then
  echo "❌ SCOPE_NRN is required" >&2
  echo "💡 Possible causes:" >&2
  echo "   - Scope context not available in the environment" >&2
  echo "   - NRN not passed from the deployment pipeline" >&2
  echo "🔧 How to fix:" >&2
  echo "   - Verify SCOPE_NRN is exported before this script runs" >&2
  echo "   - Check the deployment agent configuration" >&2
  return 1
fi

main_alias="${LAMBDA_MAIN_ALIAS_NAME:-main}"

# ── Fill the gaps left by a run without tofu ──────────────────────────────────
if [ -n "${LAMBDA_FUNCTION_NAME:-}" ]; then
  if [ -z "${LAMBDA_FUNCTION_ARN:-}" ] || [ -z "${LAMBDA_EXECUTION_ROLE_ARN:-}" ]; then
    if fn_config=$(aws lambda get-function-configuration \
      --function-name "$LAMBDA_FUNCTION_NAME" --output json 2>/dev/null); then
      [ -z "${LAMBDA_FUNCTION_ARN:-}" ] && LAMBDA_FUNCTION_ARN=$(echo "$fn_config" | jq -r '.FunctionArn // ""')
      if [ -z "${LAMBDA_EXECUTION_ROLE_ARN:-}" ]; then
        LAMBDA_EXECUTION_ROLE_ARN=$(echo "$fn_config" | jq -r '.Role // ""')
      fi
    else
      log debug "   ⏭️  Could not read function configuration — skipping identity backfill"
    fi
  fi

  if [ -z "${LAMBDA_ALIAS_ARN:-}" ]; then
    LAMBDA_ALIAS_ARN=$(aws lambda get-alias \
      --function-name "$LAMBDA_FUNCTION_NAME" \
      --name "$main_alias" \
      --query 'AliasArn' --output text 2>/dev/null || echo "")
    [ "$LAMBDA_ALIAS_ARN" = "None" ] && LAMBDA_ALIAS_ARN=""
  fi
fi

if [ -z "${LAMBDA_EXECUTION_ROLE_NAME:-}" ] && [ -n "${LAMBDA_EXECUTION_ROLE_ARN:-}" ]; then
  LAMBDA_EXECUTION_ROLE_NAME="${LAMBDA_EXECUTION_ROLE_ARN##*/}"
fi

# ── Build the payload from whatever resolved ──────────────────────────────────
metadata='{}'

add_metadata() {
  local key="$1" value="$2"
  if [ -z "$value" ] || [ "$value" = "null" ]; then
    return 0
  fi
  metadata=$(echo "$metadata" | jq --arg k "$key" --arg v "$value" '. + {($k): $v}')
  log debug "   ✅ $key=$value"
}

add_metadata "function_name"       "${LAMBDA_FUNCTION_NAME:-}"
add_metadata "function_arn"        "${LAMBDA_FUNCTION_ARN:-}"
add_metadata "alias_arn"           "${LAMBDA_ALIAS_ARN:-}"
# The alias name only means something alongside a function
[ -n "${LAMBDA_FUNCTION_NAME:-}" ] && add_metadata "main_alias" "$main_alias"
add_metadata "execution_role_arn"  "${LAMBDA_EXECUTION_ROLE_ARN:-}"
add_metadata "execution_role_name" "${LAMBDA_EXECUTION_ROLE_NAME:-}"

# Non-HTTP (event-driven) scopes skip ALB setup entirely and won't have this set.
if [ -n "${ALB_RULE_PRIORITY:-}" ]; then
  # Validate before --argjson: invalid JSON makes jq fail and would wipe the
  # identity keys other services read, while still reporting success.
  if [[ "$ALB_RULE_PRIORITY" =~ ^[0-9]+$ ]]; then
    metadata=$(echo "$metadata" | jq --argjson p "$ALB_RULE_PRIORITY" '. + {alb_rule_priority: $p}')
    log debug "   ✅ alb_rule_priority=$ALB_RULE_PRIORITY"
  else
    log warn "   ⚠️  Ignoring non-numeric ALB_RULE_PRIORITY='$ALB_RULE_PRIORITY'"
  fi
fi

if [ "$(echo "$metadata" | jq 'length')" -eq 0 ]; then
  log debug "   ⏭️  Nothing resolved to store — skipping"
  return 0
fi

# Prefix with "lambda." namespace
metadata=$(echo "$metadata" | jq -c 'with_entries(.key = "lambda." + .key)')
log debug "   ✅ Final metadata payload: $metadata"

echo ""
log info "   📡 Writing metadata to NRN=$SCOPE_NRN..."

np_output=$(np nrn patch \
  --nrn "$SCOPE_NRN" \
  --body "$metadata" \
  --format json 2>&1)
np_exit_code=$?

if [ $np_exit_code -ne 0 ]; then
  echo "❌ Failed to write NRN metadata to scope=$SCOPE_NRN" >&2
  echo "💡 Possible causes:" >&2
  echo "   - NRN service is unreachable" >&2
  echo "   - Invalid metadata JSON payload" >&2
  echo "   - Insufficient permissions to write to NRN" >&2
  echo "🔧 How to fix:" >&2
  echo "   - Check NRN service connectivity" >&2
  echo "   - Verify the metadata JSON is valid" >&2
  echo "   - Ensure the agent has write permissions to the NRN namespace" >&2
  echo "   📋 Error: $np_output" >&2
  return 1
fi

log debug "   ✅ Metadata stored successfully"
echo ""
log info "✨ Scope metadata stored for $SCOPE_NRN"
