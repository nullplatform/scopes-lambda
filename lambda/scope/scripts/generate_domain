#!/bin/bash
# Resolve the scope domain and the hosted zone its record lives in.
# The scope is patched with the domain only after networking applies (see apply_networking).

source "$SERVICE_PATH/utils/log"

log info "🔍 Generating scope domain..."

SCOPE_DOMAIN=""
DNS_HOSTED_ZONE_ID=""
export SCOPE_DOMAIN DNS_HOSTED_ZONE_ID

if [ "${NETWORKING_MODE:-none}" = "none" ]; then
  log info "   ⏭️  No HTTP exposure - skipping domain generation"
  return 0
fi

if [ "$VISIBILITY" = "private" ]; then
  DNS_HOSTED_ZONE_ID="${HOSTED_PRIVATE_ZONE_ID:-${HOSTED_PUBLIC_ZONE_ID:-}}"
else
  DNS_HOSTED_ZONE_ID="${HOSTED_PUBLIC_ZONE_ID:-}"
fi

if [ -z "$DNS_HOSTED_ZONE_ID" ]; then
  if [ "$NETWORKING_MODE" = "alb" ]; then
    echo "❌ No hosted zone configured for a $VISIBILITY scope behind an ALB" >&2
    echo "" >&2
    echo "💡 Possible causes:" >&2
    echo "   The ALB routes by host header, so the scope needs a domain" >&2
    echo "" >&2
    echo "🔧 How to fix:" >&2
    echo "   • Set networking.hosted_public_zone_id (and hosted_zone_id for private scopes) in the cloud-providers provider" >&2
    exit 1
  fi
  log info "   ⏭️  No hosted zone configured - the API Gateway endpoint is the scope domain"
  return 0
fi

log debug "   ✅ hosted_zone_id=$DNS_HOSTED_ZONE_ID"

aws_output=$(aws route53 get-hosted-zone --id "$DNS_HOSTED_ZONE_ID" --output json 2>&1)
aws_exit_code=$?

if [ $aws_exit_code -ne 0 ]; then
  echo "❌ Failed to fetch Route 53 hosted zone '$DNS_HOSTED_ZONE_ID'" >&2
  echo "" >&2
  echo "💡 Possible causes:" >&2
  echo "   - Invalid hosted zone ID" >&2
  echo "   - Missing route53:GetHostedZone permission" >&2
  echo "" >&2
  echo "🔧 How to fix:" >&2
  echo "   • Verify the hosted zone IDs in the cloud-providers provider" >&2
  echo "   📋 AWS error: $aws_output" >&2
  exit 1
fi

base_domain=$(echo "$aws_output" | jq -r '.HostedZone.Name // empty' | sed 's/\.$//')

if [ -z "$base_domain" ]; then
  echo "❌ Could not read the domain name of hosted zone '$DNS_HOSTED_ZONE_ID'" >&2
  exit 1
fi

if [ "${USE_ACCOUNT_SLUG:-true}" = "true" ]; then
  subdomain="${NAMESPACE_SLUG}-${APPLICATION_SLUG}-${SCOPE_SLUG}.${ACCOUNT_SLUG}"
else
  subdomain="${NAMESPACE_SLUG}-${APPLICATION_SLUG}-${SCOPE_SLUG}"
fi

SCOPE_DOMAIN="${subdomain}.${base_domain}"

# DNS caps a label at 63 chars; route53 rejects longer ones at apply time.
IFS='.' read -ra labels <<< "$SCOPE_DOMAIN"
for label in "${labels[@]}"; do
  if [ "${#label}" -gt 63 ]; then
    echo "❌ Domain label '$label' exceeds 63 characters" >&2
    echo "" >&2
    echo "🔧 How to fix:" >&2
    echo "   • Shorten the namespace, application or scope slug" >&2
    exit 1
  fi
done

log info "   ✅ scope_domain=$SCOPE_DOMAIN"
