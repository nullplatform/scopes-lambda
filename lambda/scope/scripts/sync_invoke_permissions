#!/bin/bash
# Reconcile lambda.triggers.invoke_permissions from the scope-configuration.
#
# Grants target the main alias, so external triggers respect blue/green weights.
# Only Sids carrying our prefix are removed — never AllowAPIGatewayInvoke,
# AllowALBInvoke, or anything added out of band.

source "$SERVICE_PATH/utils/log"

NP_INVOKE_SID_PREFIX="np-ext-"

log info "🔍 Reconciling external invoke permissions..."

if [ -z "${LAMBDA_FUNCTION_NAME:-}" ] || [ "$LAMBDA_FUNCTION_NAME" = "null" ]; then
  echo "❌ LAMBDA_FUNCTION_NAME is required but not set" >&2
  echo "💡 Possible causes:" >&2
  echo "   - build_context step failed to resolve the function name" >&2
  echo "   - The step was added to the workflow without declaring the variable as an output" >&2
  echo "🔧 How to fix:" >&2
  echo "   - Verify LAMBDA_FUNCTION_NAME is listed in the build_context step outputs" >&2
  echo "   - Re-run the diagnose-scope action to check scope health" >&2
  return 1
fi

# Entries may name their scope by slug or id. Missing either would filter such
# an entry out and then prune the statement it created — revoking a live
# trigger. Fail instead.
for required in SCOPE_ID SCOPE_SLUG; do
  if [ -z "${!required:-}" ] || [ "${!required}" = "null" ]; then
    echo "❌ $required is required but not set" >&2
    echo "💡 Possible causes:" >&2
    echo "   - The step was added to a workflow without declaring $required as a build_context output" >&2
    echo "🔧 How to fix:" >&2
    echo "   - Add $required to the build_context step outputs of that workflow" >&2
    return 1
  fi
done

invoke_alias="${LAMBDA_MAIN_ALIAS_NAME:-main}"

if ! desired=$(echo "$CONTEXT" | jq -ce '.providers["scope-configurations"].triggers.invoke_permissions // [] | if type == "array" then . else error("not an array") end' 2>&1); then
  echo "❌ Could not read triggers.invoke_permissions from the scope configuration" >&2
  echo "💡 Possible causes:" >&2
  echo "   - CONTEXT is empty or malformed, so the declared set is unknown" >&2
  echo "   - invoke_permissions was saved as something other than a list" >&2
  echo "🔧 How to fix:" >&2
  echo "   - Re-run the action; treating an unreadable config as empty would" >&2
  echo "     remove every external trigger this scope has" >&2
  echo "   📋 jq error: $desired" >&2
  return 1
fi

declared_count=$(echo "$desired" | jq 'length')

# Entries may name the scope they are for. Without that, a value inherited from
# a higher NRN would grant the same principal on every lambda scope below it.
desired=$(echo "$desired" | jq -c --arg slug "${SCOPE_SLUG:-}" --arg id "${SCOPE_ID:-}" \
  '[ .[] | select((.scope // "") as $s | $s == "" or $s == $slug or $s == $id) ]')

desired_count=$(echo "$desired" | jq 'length')

log debug "   📋 function_name=$LAMBDA_FUNCTION_NAME"
log debug "   📋 qualifier=$invoke_alias"
log debug "   📋 declared_permissions=$declared_count (for this scope: $desired_count)"

# ── Validate every entry before touching AWS ──────────────────────────────────
# Rejecting an entry after the prune loop already removed the statement it was
# meant to replace would leave a working trigger with no grant at all.
duplicate_sid=$(echo "$desired" | jq -r 'group_by(.statement_id) | map(select(length > 1)) | first | first.statement_id // empty')
if [ -n "$duplicate_sid" ]; then
  echo "❌ Duplicate statement_id '$duplicate_sid' in invoke_permissions" >&2
  echo "💡 Possible causes:" >&2
  echo "   - Two entries were given the same name" >&2
  echo "🔧 How to fix:" >&2
  echo "   - Give every entry a distinct statement_id" >&2
  return 1
fi

while IFS= read -r perm; do
  [ -z "$perm" ] && continue

  statement_id=$(echo "$perm" | jq -r '.statement_id // ""')
  principal=$(echo "$perm" | jq -r '.principal // ""')

  if [ -z "$statement_id" ] || [ -z "$principal" ]; then
    echo "❌ Invoke permission is missing 'statement_id' or 'principal': $perm" >&2
    echo "💡 Possible causes:" >&2
    echo "   - The scope-configuration entry was saved with an incomplete object" >&2
    echo "🔧 How to fix:" >&2
    echo "   - Set both statement_id and principal on every invoke_permissions entry" >&2
    return 1
  fi

  # AWS restricts StatementId to [a-zA-Z0-9-_] and 100 characters, and our prefix
  # eats part of that budget — fail here rather than on an opaque AWS error.
  if ! [[ "$statement_id" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "❌ Invalid statement_id '$statement_id': only letters, digits, '-' and '_' are allowed" >&2
    echo "💡 Possible causes:" >&2
    echo "   - The statement_id contains dots, colons or spaces (e.g. an ARN was pasted)" >&2
    echo "🔧 How to fix:" >&2
    echo "   - Use a short symbolic name, e.g. 'apigw-authorizer' or 'eventbridge-daily'" >&2
    return 1
  fi

  if [ ${#statement_id} -gt $((100 - ${#NP_INVOKE_SID_PREFIX})) ]; then
    echo "❌ statement_id '$statement_id' is too long" >&2
    echo "💡 Possible causes:" >&2
    echo "   - AWS caps StatementId at 100 characters, and '$NP_INVOKE_SID_PREFIX' is prepended" >&2
    echo "🔧 How to fix:" >&2
    echo "   - Shorten the statement_id to at most $((100 - ${#NP_INVOKE_SID_PREFIX})) characters" >&2
    return 1
  fi
done < <(echo "$desired" | jq -c '.[]')

# ── Current state ─────────────────────────────────────────────────────────────
# Only "no policy yet" may be treated as empty. Swallowing every error would
# make an AccessDenied look like a fresh function: nothing gets pruned, and
# every add-permission then fails with ResourceConflictException.
if policy_json=$(aws lambda get-policy \
  --function-name "$LAMBDA_FUNCTION_NAME" \
  --qualifier "$invoke_alias" \
  --query 'Policy' \
  --output text 2>&1); then
  if [ -z "$policy_json" ] || [ "$policy_json" = "None" ]; then
    current_statements="[]"
  else
    current_statements=$(echo "$policy_json" | jq -c '.Statement // []')
  fi
elif [[ "$policy_json" == *ResourceNotFoundException* ]]; then
  log debug "   ⏭️  No resource policy yet on $LAMBDA_FUNCTION_NAME:$invoke_alias"
  current_statements="[]"
else
  echo "❌ Failed to read the resource policy of '$LAMBDA_FUNCTION_NAME'" >&2
  echo "💡 Possible causes:" >&2
  echo "   - Permission denied (missing lambda:GetPolicy)" >&2
  echo "   - Throttling, or the '$invoke_alias' alias does not exist" >&2
  echo "🔧 How to fix:" >&2
  echo "   - Check the assume role has lambda:GetPolicy on the function" >&2
  echo "   - Run diagnose-scope to confirm the function and alias are healthy" >&2
  echo "   📋 AWS error: $policy_json" >&2
  return 1
fi

managed_sids=$(echo "$current_statements" | jq -r --arg p "$NP_INVOKE_SID_PREFIX" \
  '.[] | select(.Sid | startswith($p)) | .Sid')

# ── Remove managed statements that are no longer declared ─────────────────────
desired_sids=$(echo "$desired" | jq -r --arg p "$NP_INVOKE_SID_PREFIX" '.[] | $p + .statement_id')

while IFS= read -r sid; do
  [ -z "$sid" ] && continue
  if ! echo "$desired_sids" | grep -qxF "$sid"; then
    log info "   📝 Removing permission no longer declared: $sid"
    if ! aws_output=$(aws lambda remove-permission \
      --function-name "$LAMBDA_FUNCTION_NAME" \
      --qualifier "$invoke_alias" \
      --statement-id "$sid" 2>&1); then
      echo "❌ Failed to remove invoke permission '$sid' from '$LAMBDA_FUNCTION_NAME'" >&2
      echo "💡 Possible causes:" >&2
      echo "   - Permission denied (missing lambda:RemovePermission)" >&2
      echo "   - The statement was removed concurrently by another process" >&2
      echo "🔧 How to fix:" >&2
      echo "   - Check the assume role has lambda:RemovePermission on the function" >&2
      echo "   - Re-run the action; removal is idempotent" >&2
      echo "   📋 AWS error: $aws_output" >&2
      return 1
    fi
  fi
done <<< "$managed_sids"

# ── Add or refresh declared statements ────────────────────────────────────────
while IFS= read -r perm; do
  [ -z "$perm" ] && continue

  statement_id=$(echo "$perm" | jq -r '.statement_id // ""')
  principal=$(echo "$perm" | jq -r '.principal // ""')
  source_arn=$(echo "$perm" | jq -r '.source_arn // ""')
  source_account=$(echo "$perm" | jq -r '.source_account // ""')
  action=$(echo "$perm" | jq -r '.action // "lambda:InvokeFunction"')
  sid="${NP_INVOKE_SID_PREFIX}${statement_id}"

  # add-permission cannot update in place, so a changed principal/source means
  # remove + add. Compare against the live statement to stay idempotent.
  existing=$(echo "$current_statements" | jq -c --arg sid "$sid" 'map(select(.Sid == $sid)) | first // empty')

  if [ -n "$existing" ]; then
    if [ "$(echo "$existing" | jq -r 'if (.Action | type) == "array" and (.Action | length) > 1 then "multi" else "single" end')" = "multi" ]; then
      log warn "   ⚠️  Leaving $sid untouched: it grants several actions, which add-permission cannot recreate"
      continue
    fi

    cur_principal=$(echo "$existing" | jq -r '.Principal | if type == "string" then . else (.Service // .AWS // tostring) end')
    cur_action=$(echo "$existing" | jq -r 'if (.Action | type) == "array" then .Action[0] else .Action end // ""')
    cur_source_arn=$(echo "$existing" | jq -r '.Condition.ArnLike."AWS:SourceArn" // ""')
    cur_source_account=$(echo "$existing" | jq -r '.Condition.StringEquals."AWS:SourceAccount" // ""')

    # AWS stores a bare account id as arn:aws:iam::<id>:root
    declared_principal="$principal"
    if [[ "$principal" =~ ^[0-9]{12}$ ]]; then
      declared_principal="arn:aws:iam::${principal}:root"
    fi

    if [ "$cur_principal" = "$declared_principal" ] && [ "$cur_action" = "$action" ] && \
       [ "$cur_source_arn" = "$source_arn" ] && [ "$cur_source_account" = "$source_account" ]; then
      log debug "   ⏭️  $sid already up to date"
      continue
    fi

    log info "   📝 Refreshing changed permission: $sid"
    if ! aws_output=$(aws lambda remove-permission \
      --function-name "$LAMBDA_FUNCTION_NAME" \
      --qualifier "$invoke_alias" \
      --statement-id "$sid" 2>&1); then
      echo "❌ Failed to replace invoke permission '$sid' on '$LAMBDA_FUNCTION_NAME'" >&2
      echo "💡 Possible causes:" >&2
      echo "   - Permission denied (missing lambda:RemovePermission)" >&2
      echo "🔧 How to fix:" >&2
      echo "   - Check the assume role has lambda:RemovePermission on the function" >&2
      echo "   📋 AWS error: $aws_output" >&2
      return 1
    fi
    replaced="$existing"
  else
    log info "   📝 Adding permission: $sid ($principal)"
    replaced=""
  fi

  add_args=(--function-name "$LAMBDA_FUNCTION_NAME"
            --qualifier "$invoke_alias"
            --statement-id "$sid"
            --action "$action"
            --principal "$principal")
  [ -n "$source_arn" ] && add_args+=(--source-arn "$source_arn")
  [ -n "$source_account" ] && add_args+=(--source-account "$source_account")

  if ! aws_output=$(aws lambda add-permission "${add_args[@]}" 2>&1); then
    # A refresh already removed the old statement. Put it back, or a typo in the
    # config would silently break a trigger that was working a moment ago.
    if [ -n "$replaced" ]; then
      log warn "   ⚠️  Restoring the previous $sid statement after the failed update"
      restore_args=(--function-name "$LAMBDA_FUNCTION_NAME"
                    --qualifier "$invoke_alias"
                    --statement-id "$sid"
                    --action "$cur_action"
                    --principal "$cur_principal")
      [ -n "$cur_source_arn" ] && restore_args+=(--source-arn "$cur_source_arn")
      [ -n "$cur_source_account" ] && restore_args+=(--source-account "$cur_source_account")
      aws lambda add-permission "${restore_args[@]}" >/dev/null 2>&1 \
        || log warn "   ⚠️  Could not restore $sid — the trigger is left without a grant"
    fi

    echo "❌ Failed to add invoke permission '$sid' to '$LAMBDA_FUNCTION_NAME'" >&2
    echo "💡 Possible causes:" >&2
    echo "   - Permission denied (missing lambda:AddPermission)" >&2
    echo "   - Invalid principal '$principal' or malformed source_arn" >&2
    echo "   - The '$invoke_alias' alias does not exist on the function" >&2
    echo "🔧 How to fix:" >&2
    echo "   - Verify the principal is an AWS service principal (e.g. events.amazonaws.com)" >&2
    echo "   - Verify source_arn belongs to the same account and region as the function" >&2
    echo "   - Run diagnose-scope to confirm the function and alias are healthy" >&2
    echo "   📋 AWS error: $aws_output" >&2
    return 1
  fi
done < <(echo "$desired" | jq -c '.[]')

echo ""
if [ "$desired_count" != "$declared_count" ]; then
  log info "✨ External invoke permissions reconciled ($desired_count of $declared_count declared apply to this scope)"
else
  log info "✨ External invoke permissions reconciled ($desired_count declared)"
fi
