#!/bin/bash
# Configure the scope's HTTP API. The scope domain becomes a custom domain only when a certificate is configured.

source "$SERVICE_PATH/utils/log"
source "$SERVICE_PATH/utils/get_config_value"

log info "🔍 Validating API Gateway configuration..."

api_gateway_name="${NAMESPACE_SLUG}-${APPLICATION_SLUG}-${SCOPE_SLUG}"
stage_name="${API_GATEWAY_STAGE_NAME:-main}"
throttling_burst_limit="${API_GATEWAY_THROTTLING_BURST_LIMIT:-5000}"
throttling_rate_limit="${API_GATEWAY_THROTTLING_RATE_LIMIT:-10000}"

certificate_arn=$(get_config_value \
  --provider '.providers["scope-configurations"].networking.api_gateway_certificate_arn' \
  --env API_GATEWAY_CERTIFICATE_ARN \
  --default ""
)

API_GATEWAY_CUSTOM_DOMAIN=""
if [ -n "${SCOPE_DOMAIN:-}" ] && [ -n "$certificate_arn" ]; then
  API_GATEWAY_CUSTOM_DOMAIN="$SCOPE_DOMAIN"
elif [ -n "${SCOPE_DOMAIN:-}" ]; then
  log warn "   ⚠️  No API Gateway certificate configured - the scope is served on its execute-api endpoint"
fi
export API_GATEWAY_CUSTOM_DOMAIN

log debug "   ✅ api_name=$api_gateway_name"
log debug "   ✅ stage_name=$stage_name"
log debug "   ✅ custom_domain=${API_GATEWAY_CUSTOM_DOMAIN:-(none)}"

RESOURCE_TAGS_JSON=${RESOURCE_TAGS_JSON:-"{}"}

TOFU_VARIABLES=$(echo "$TOFU_VARIABLES" | jq \
  --arg api_name "$api_gateway_name" \
  --arg stage_name "$stage_name" \
  --argjson burst_limit "$throttling_burst_limit" \
  --argjson rate_limit "$throttling_rate_limit" \
  --arg custom_domain "$API_GATEWAY_CUSTOM_DOMAIN" \
  --arg certificate_arn "$certificate_arn" \
  --arg hosted_zone_id "${DNS_HOSTED_ZONE_ID:-}" \
  --arg function_name "$LAMBDA_FUNCTION_NAME" \
  --arg alias_name "${LAMBDA_MAIN_ALIAS_NAME:-main}" \
  --argjson resource_tags_json "$RESOURCE_TAGS_JSON" \
  '. + {
    api_gateway_name: $api_name,
    api_gateway_stage_name: $stage_name,
    api_gateway_throttling_burst_limit: $burst_limit,
    api_gateway_throttling_rate_limit: $rate_limit,
    api_gateway_custom_domain: $custom_domain,
    api_gateway_certificate_arn: $certificate_arn,
    api_gateway_hosted_zone_id: $hosted_zone_id,
    api_gateway_lambda_function_name: $function_name,
    api_gateway_lambda_alias_name: $alias_name,
    api_gateway_resource_tags_json: $resource_tags_json
  }')

log info "✨ API Gateway configured successfully"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module_name="${script_dir}/modules"

if [[ -n $MODULES_TO_USE ]]; then
  MODULES_TO_USE="$MODULES_TO_USE,$module_name"
else
  MODULES_TO_USE="$module_name"
fi
