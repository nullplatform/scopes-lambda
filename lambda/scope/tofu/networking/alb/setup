#!/bin/bash
# Configure the scope's target group and listener rule on the ALB picked by select_alb.

source "$SERVICE_PATH/utils/log"

log info "🔍 Validating ALB configuration..."

if [ -z "${ALB_LISTENER_ARN:-}" ] || [ -z "${ALB_RULE_PRIORITY:-}" ]; then
  echo "❌ No ALB listener selected for this scope" >&2
  echo "" >&2
  echo "🔧 How to fix:" >&2
  echo "   • Ensure the select_alb step runs before setup_networking" >&2
  exit 1
fi

# Target group names are unique per account and region, capped at 32 chars.
# A rule that already exists keeps its target group (scopes created by earlier versions).
target_group_name="${ALB_TARGET_GROUP_NAME:-lmb-${SCOPE_ID}}"
target_group_name="${target_group_name:0:32}"

health_check_path=$(echo "$CONTEXT" | jq -r '.scope.capabilities.health_check.path // "/health"')
health_check_enabled="true"
if [ -z "$health_check_path" ] || [ "$health_check_path" = "null" ]; then
  health_check_enabled="false"
  health_check_path="/health"
fi

log debug "   ✅ listener_arn=$ALB_LISTENER_ARN"
log debug "   ✅ rule_priority=$ALB_RULE_PRIORITY"
log debug "   ✅ target_group_name=$target_group_name"
log debug "   ✅ host_header=$SCOPE_DOMAIN"
log debug "   ✅ health_check_path=$health_check_path (enabled=$health_check_enabled)"

RESOURCE_TAGS_JSON=${RESOURCE_TAGS_JSON:-"{}"}

TOFU_VARIABLES=$(echo "$TOFU_VARIABLES" | jq \
  --arg listener_arn "$ALB_LISTENER_ARN" \
  --arg target_group_name "$target_group_name" \
  --arg host_header "$SCOPE_DOMAIN" \
  --argjson priority "$ALB_RULE_PRIORITY" \
  --arg health_check_path "$health_check_path" \
  --argjson health_check_enabled "$health_check_enabled" \
  --arg function_name "$LAMBDA_FUNCTION_NAME" \
  --arg alias_name "${LAMBDA_MAIN_ALIAS_NAME:-main}" \
  --argjson resource_tags_json "$RESOURCE_TAGS_JSON" \
  '. + {
    alb_listener_arn: $listener_arn,
    alb_target_group_name: $target_group_name,
    alb_host_header: $host_header,
    alb_rule_priority: $priority,
    alb_health_check_path: $health_check_path,
    alb_health_check_enabled: $health_check_enabled,
    alb_lambda_function_name: $function_name,
    alb_lambda_alias_name: $alias_name,
    alb_resource_tags_json: $resource_tags_json
  }')

log info "✨ ALB configured successfully"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module_name="${script_dir}/modules"

if [[ -n $MODULES_TO_USE ]]; then
  MODULES_TO_USE="$MODULES_TO_USE,$module_name"
else
  MODULES_TO_USE="$module_name"
fi
