#!/bin/bash
# Configure the alias record from the scope domain to the ALB picked by select_alb.

source "$SERVICE_PATH/utils/log"

log info "🔍 Validating Route53 DNS configuration..."

if [ -z "${DNS_HOSTED_ZONE_ID:-}" ] || [ -z "${SCOPE_DOMAIN:-}" ] || [ -z "${ALB_DNS_NAME:-}" ] || [ -z "${ALB_ZONE_ID:-}" ]; then
  echo "❌ Missing DNS inputs: zone='${DNS_HOSTED_ZONE_ID:-}' domain='${SCOPE_DOMAIN:-}' alb='${ALB_DNS_NAME:-}'" >&2
  echo "" >&2
  echo "🔧 How to fix:" >&2
  echo "   • Ensure generate_domain and select_alb run before setup_networking" >&2
  exit 1
fi

log debug "   ✅ hosted_zone_id=$DNS_HOSTED_ZONE_ID"
log debug "   ✅ full_domain=$SCOPE_DOMAIN"
log debug "   ✅ alb_dns_name=$ALB_DNS_NAME"

TOFU_VARIABLES=$(echo "$TOFU_VARIABLES" | jq \
  --arg hosted_zone_id "$DNS_HOSTED_ZONE_ID" \
  --arg full_domain "$SCOPE_DOMAIN" \
  --arg alb_dns_name "$ALB_DNS_NAME" \
  --arg alb_zone_id "$ALB_ZONE_ID" \
  '. + {
    dns_hosted_zone_id: $hosted_zone_id,
    dns_full_domain: $full_domain,
    dns_alb_dns_name: $alb_dns_name,
    dns_alb_zone_id: $alb_zone_id
  }')

log info "✨ Route53 DNS configured successfully"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module_name="${script_dir}/modules"

if [[ -n $MODULES_TO_USE ]]; then
  MODULES_TO_USE="$MODULES_TO_USE,$module_name"
else
  MODULES_TO_USE="$module_name"
fi
